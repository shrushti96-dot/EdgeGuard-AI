# EdgeGuard AI - Azure Machine Learning Configuration
# Set these variables to enable cloud model registry integration.
# Leave blank to operate in local autonomous Edge simulation mode.

AZURE_SUBSCRIPTION_ID=your-azure-subscription-id-here
AZURE_RESOURCE_GROUP=your-azure-resource-group-name
AZURE_WORKSPACE_NAME=your-azure-ml-workspace-name

# Optional: Service Principal Authentication (If not using Azure CLI 'az login')
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-service-principal-client-id
AZURE_CLIENT_SECRET=your-service-principal-client-secret

# IoT Edge Simulation Settings
SIMULATION_INTERVAL_SEC=3
RISK_THRESHOLD=0.50
